@dialects { visualink }

@top Script { endOfLine* lineSep<line>? knotOrFunction* }

@precedence {
  restrictedPath @left,
  pathComponent @left,
  list @left,
  parens @left,
  mod @left,
  divide @left,
  multiply @left,
  subtract @left,
  add @left,
  presence @left,
  comparison @left,
  andOr @left,
  functionCall @left,
  variableName @left,
  blockCase @left,
  keyword @left,
  condition @left,
  choiceDivert @left,
  choice @left,
  content @left
}

line {
  AuthorWarning |
  Include |
  VariableDeclaration |
  ConstDeclaration |
  ListDeclaration |
  StackDeclaration |
  ExternalDeclaration |
  VariableAssignment |
  choice |
  Gather |
  ThreadLine |
  textLine
}

blockLine {
  AuthorWarning |
  VariableDeclaration |
  ConstDeclaration |
  ListDeclaration |
  StackDeclaration |
  VariableAssignment |
  choice |
  ThreadLine |
  textLine
}

textLine {
  ContentLine |
  conditionalLine |
  BlockSequence
}

@skip { (spaces | BlockComment) }
@context trackKnotName from "./context"

glueLine { ~opening !content Glue (content* ((Glue? | Tag*) | (Tag* | Glue?)) Divert?) }
nonGlueLine { ~opening !content (content+ (Tag* | Glue?) Divert?) }
tagLine { ~opening !content Tag+ Glue? Divert? }
divertLine { ~opening !content Divert }
ContentLine[group="Text"] { glueLine | nonGlueLine | tagLine | divertLine }
AuthorWarning[group="Comment"] { ~opening !keyword todo notEol+ eol }
todo[@dynamicPrecedence=1] { @extend<contentWord, "TODO:"> }
Include { ~opening !keyword opener<"INCLUDE"> notEol+ eol }
openBracketedChoiceName[@dynamicPrecedence=1] { !parens @extend<choiceContentWord, "("> }
openBracketedGatherName[@dynamicPrecedence=1] { !parens @extend<contentWord, "("> }
openWeaveBracket[@dynamicPrecedence=1] { !parens @extend<choiceContentWord, "["> }

content {
  contentWord | contentEscape | inline
}

// Knots and Stitches
@external tokens endOfKnot from "./tokens" {
  endOfKnotMarker,
  endOfStitchMarker
}

knotOrFunction {
  Knot | Function
}
Function[group="Operator"] { knotMarker ~functionOrKnot kw<"function"> knotOrFunctionTail endOfLine+ lineSep<line> endOfKnotMarker }
Knot[group="Operator"] { knotMarker ~functionOrKnot knotOrFunctionTail endOfLine+ lineSep<line>? Stitch* endOfKnotMarker }
KnotName[group="Names"] { !parens identifier }
knotOrFunctionTail { KnotName KnotArguments? knotMarker? }
KnotArguments[group="Operator"] { "(" commaSep<knotArgument> ")" }
knotArgument { kw<"ref">? Name }
StitchName[group="Names"] { !parens identifier }
Stitch[group="Operator"] { ~opening stitchMarker StitchName KnotArguments? stitchMarker? endOfLine+ lineSep<line> endOfStitchMarker }
Gather[group="Operator"] { ~opening !keyword gatherMarker+ (gatherNamed | gatherUnnamed) }
gatherNamed { BracketedGatherName textLine? }
gatherUnnamed { textLine? }
BracketedGatherName[group="Names"] { openBracketedGatherName Name ")" }

// To avoid issues with dashes being "mis-tokenized" midline, we need
// the gather marker at the line start to be an extension of the broader
// contentWord token. Unfortunately, extending going only be done with
// literal values, so we are limited to supporting a fixed depth of gathers.
gatherMarker[@dynamicPrecedence=2] {
  opener<"-"> |
  opener<"--"> |
  opener<"---"> |
  opener<"----"> |
  opener<"-----"> |
  opener<"------"> |
  opener<"-------">
}

// Declarations
VariableDeclaration[group="Keyword"] {
  ~opening !keyword opener<"VAR"> Name "=" (literal | List | ExpressionDivertTarget | Stack)
}
ConstDeclaration {
  ~opening !keyword opener<"CONST"> Name "=" (literal | List | ExpressionDivertTarget | Stack)
}
ListDeclaration {
  ~opening !keyword opener<"LIST"> Name "=" endOfLine? ListDefinition
}
ListDefinition {
  (Name | SelectedName) ("," endOfLine? (Name | SelectedName))*
}
SelectedName[group="Names"] {
  "(" identifier ")"
}
// Provided by plugins in the VisualInk environment, not part of the Ink standard
StackDeclaration[@dynamicPrecedence=1] {
  ~opening !keyword visualinkOpener<"STACK"> Name Int (literal | List | ExpressionDivertTarget)
}
ExternalDeclaration[@dynamicPrecedence=1] {
  ~opening !keyword opener<"EXTERNAL"> FunctionCall
}

// Assignments
VariableAssignment[group="Operator"] {
  !keyword assignmentMarker (Return expression | Temp? Name (variableAssignValue | Adjust | IncDec))
}
Temp[group="Keyword"] {
  "temp"
}
Return[group="Keyword"] {
  "return"
}
variableAssignValue {
  "=" expression
}
Adjust[group="Operator"] {
  ("+=" | "-=") (literal | Name | List)
}
IncDec[group="Operator"] {
  "++" | "--"
}

// Choices
choice { OnceOnlyChoice | RepeatingChoice }
OnceOnlyChoice[group="Operator"] {
  onceOnlyChoiceMarker+ choiceTail
}
RepeatingChoice[group="Operator"] {
  repeatingChoiceMarker+ choiceTail
}
choiceTail {
  BracketedChoiceName? (!condition ChoiceCondition)* choiceContentStart ChoiceTag* Divert?
}
choiceContentStart {
  (PreweaveChoiceContent (WeaveBracket PostweaveChoiceContent?)?) | (WeaveBracket PostweaveChoiceContent?)
}
PreweaveChoiceContent[group="Text"] { choiceContent (choiceContent | inline)* }
PostweaveChoiceContent[group="Text"] { (choiceContent | inline)+ }
BracketedChoiceName[group="Operator"] { openBracketedChoiceName Name ")" }
WeaveBracket[group="Operator"] { openWeaveBracket WeaveContent ChoiceTag* "]" }
WeaveContent[group="Text"] { (choiceContentWord | inline)* }
choiceContent {
  choiceContentWord | contentEscape
}
ChoiceCondition[group="Operator"] { "{" ~bracket expression "}" }

// Blocks
@external tokens checkBrace from "./tokens" {
  inlineConditionalOpen,
  inlineSequenceOpen,
  inlineDisplayVariableOpen,
  blockOpen
}

inline {
  Conditional | InlineSequence | InlineDisplayVariable
}

Conditional[group="Operator"] {
   "{" ~bracket inlineConditionalOpen conditionMarker? expression ":" ConditionalContent Divert? "}"
}
ConditionalContent[group="Text"] { content+ }
BlockConditional[group="Operator"] {
  "{" ~bracket blockOpen conditionMarker? BlockConditionCase blockTail |
  "{" ~bracket endOfLine+ blockTail
}
InlineDisplayVariable[group="Operator"] {
  "{" ~bracket inlineDisplayVariableOpen Name ("(" commaSep<expression> ")")? "}"
}
blockTail {
  (blockConditionCaseLine | blockLine endOfLine+)+ "}"
}
BlockConditionCase[group="Operator"] { expression ":" ContentLine? endOfLine+ }
blockConditionCaseLine { caseOpener BlockConditionCase }
caseOpener[@dynamicPrecedence=1] { ~opener opener<"-"> }
conditionalLine { !keyword BlockConditional }

BlockSequence[group="Operator"] {
  "{" ~bracket blockOpen blockSequenceKeyword ":" endOfLine+
  lineSep<BlockSequenceItem | textLine>
  "}"
}
BlockSequenceItem[group="Operator"] { caseOpener textLine }

blockSequenceKeyword {
  kw<"stopping"> | kw<"shuffle"> | kw<"cycle"> | kw<"once">
}

InlineSequence[group="Operator"] {
  "{" ~bracket inlineSequenceOpen SequenceTypeMarker? pipeSep1<SequenceContent> "}"
}
SequenceContent[group="Text"] { content* Divert? }

// Tags
Tag[group="Tags"] { "#" openTagContent+  }
ChoiceTag[group="Tags"] { "#" (choiceTagContent | choiceTagNotDivert)+ }

// Threads
ThreadLine[group="Operator"] { !keyword threadArrow DivertTarget }

// Logic
Name[group="Names"] { !parens identifier }

expression {
    binaryOperator[@isGroup=Operator] {
      ExpressionAndOr { expression !andOr andOrOp expression } |
      ExpressionComparison { expression !comparison comparisonOp expression } |
      ExpressionPresence { expression !presence presenceOp expression } |
      ExpressionMod { expression !add ("%" | "mod") expression } |
      ExpressionAdd { expression !add "+" expression } |
      ExpressionSubtract { expression !subtract "-" expression } |
      ExpressionMultiply { expression !multiply "*" expression } |
      ExpressionDivide { expression !divide "/" expression }
    } |
    ExpressionParen { !parens "(" expression ")" } |
    ExpressionNot { kw<"not"> expression } |
    FunctionCall |
    expressionVariableReference { !variableName Name } |
    expressionPathReference { !variableName Path } |
    List |
    ExpressionDivertTarget |
    Stack |
    literal
}

ExpressionDivertTarget { DivertArrow DivertTarget }
List[group="Operator"] { !list "(" commaSep<ListMember> ")" } 
Stack[group="Operator"] { !list "[" commaSep<expression> "]" }
FunctionCall[group="Operator"] { !functionCall Name "(" commaSep<expression> ")" }

literal[@isGroup=Literal] {
  Bool |
  String |
  Int |
  Float
}

Bool { kw<"true"> | kw<"false"> }
String { string }
Int { int }
Float { float }

@local tokens {
  stringEnd { '"' }
  stringEscape { "\\" _ }
  @else stringContent
}

@skip {} { string { '"' (stringContent | stringEscape)* stringEnd } }

ListMember {
  !list identifier ("." identifier)?
}

// Diverts
Divert {
    DivertArrow | TunnelReturn | DivertArrow DivertTarget Divert?
}

DivertArrow[group="Operator"] { @extend<arrowToken, "->"> }
TunnelReturn[group="Operator"] { @extend<arrowToken, "->->"> }

DivertTarget[group="Names"] {
  (!pathComponent Path) | !restrictedPath kw<"END"> | !restrictedPath kw<"DONE">
}

Path {
  identifier ("." identifier)*
}

// Comments
@skip {} { BlockComment[group="Comment"] { blockCommentStart commentContent blockCommentEnd } }

@local tokens {
  blockCommentEnd { "*/" }
  @else commentContent
}

LineComment[group="Comment"] { lineCommentStart notEol* eol }

commaSep<content> {
  (content ("," content)*)?
}
pipeSep1<content> {
  (content (Pipe content)*)
}
lineSep<content> {
  (content endOfLine+)+
}
kw<word> { @specialize[@name={word},group="Keyword"]<identifier, word> }
opener<word> { @extend[@name={word},group="Keyword"]<contentWord, word> }
visualinkOpener<word> { @extend[@name={word},@dialect=visualink,group="Keyword"]<contentWord, word> }
endOfLine { LineComment | eol }

@tokens {
  spaces { $[ \t] }
  notEol { ![\n\r] }
  eol { $[\n\r] }

  Glue[group="Operator"] { "<>" }

  andOrOp { "&&" | "||" | "and" | "or" }
  comparisonOp { "==" | "<" "="? | ">" "="? | "!=" }
  presenceOp { "?" | "has" "nt"? | "!?" | "^" }
  contentEscape { "\\" _ }
  contentChar { ![\n\r \t{}#\\|\(]  }
  contentWord { "(" | contentChar+ }

  choiceContentChar { ![\n\r \t{}#\\|[\](] }
  choiceContentWord { "(" | "[" | choiceContentChar+ }
  choiceTagContent { ![\n\r#\[\]-] }
  choiceTagNotDivert { "-" ![>] }

  onceOnlyChoiceMarker { "*"+ }
  repeatingChoiceMarker { "+"+ }

  openTagContent { ![\n\r#] }

  int { @digit+ }
  float { @digit+ "." @digit* }

  identifierChar { (identifierStartChar | @digit | "_") }
  identifierStartChar { @asciiLetter | $[\u0600-\u06FF\u0530-\u058F\u0400-\u04FF\u0370-\u03FF\u0590-\u05FF\u0100-\u017F\u0180-\u024F\u0080-\u00FF] }
  identifier { identifierStartChar identifierChar* }

  arrowToken { "->" "->"? }
  threadArrow { "<-" }
  blockCommentStart { "/*" }
  lineCommentStart { "//" }
  SequenceTypeMarker[group="Operator"] { "~" | "&" | "!" }
  conditionMarker { "-" }
  Pipe[group="Operator"] { "|" }
  assignmentMarker { "~" }
  knotMarker { "=" "="+ }
  stitchMarker { "=" }

  @precedence { knotMarker, stitchMarker, contentWord }
  @precedence { arrowToken, choiceTagContent }
  @precedence { float, int, identifier }
  @precedence { spaces, notEol }
  @precedence { presenceOp, comparisonOp }
  @precedence { arrowToken, Glue, contentWord }
  @precedence { arrowToken, Glue, choiceContentWord }
  @precedence { arrowToken, openTagContent, spaces }
  @precedence { conditionMarker, arrowToken }
  @precedence { "temp", "return", identifier }
  @precedence { assignmentMarker, contentWord }
  @precedence { SequenceTypeMarker, contentWord }
  @precedence { conditionMarker, contentWord }
  @precedence { SequenceTypeMarker, choiceContentWord }
  @precedence { conditionMarker, choiceContentWord }
  @precedence { blockCommentStart, lineCommentStart, contentWord }
  @precedence { blockCommentStart, lineCommentStart, choiceContentWord }
  @precedence { choiceTagContent, spaces }
  @precedence { onceOnlyChoiceMarker, repeatingChoiceMarker, contentWord }
  @precedence { onceOnlyChoiceMarker, repeatingChoiceMarker, choiceContentWord }
  @precedence { threadArrow, contentWord }
}